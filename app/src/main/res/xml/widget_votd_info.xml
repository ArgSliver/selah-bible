<?xml version="1.0" encoding="utf-8"?>
<!--
    Battery-optimized widget configuration:
    - updatePeriodMillis = 86400000 (24 hours; batched by Android Doze)
    - Day rollovers handled passively by DateChangeReceiver
    - Zero exact alarms, zero background services
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_votd_description"
    android:initialLayout="@layout/widget_votd"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="80dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="86400000"
    android:widgetCategory="home_screen" />
